{
  "name": "oz-backend",
  "version": "1.0.0",
  "private": true,
  "description": "OZ Library API — auth (JWT HttpOnly cookies + 2FA TOTP) + books, serves ../frontend",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "node --watch-path=. --watch-path=../frontend server.js",
    "db:init": "node db/init.js"
  },
  "dependencies": {
    "bcryptjs":      "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors":          "^2.8.5",
    "dotenv":        "^17.4.2",
    "express":       "^5.2.1",
    "helmet":        "^8.1.0",
    "jsonwebtoken":  "^9.0.2",
    "pg":            "^8.16.3",
    "qrcode":        "^1.5.4",
    "speakeasy":     "^2.0.0"
  }
}
