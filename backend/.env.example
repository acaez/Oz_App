NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_random_bytes
JWT_2FA_SECRET=change_me_too_64_random_bytes
JWT_EXPIRES=7d
JWT_2FA_EXPIRES=5m

# 2FA
TOTP_APP_NAME=ft_transcendence

# CORS
FRONTEND_URL=http://localhost:5500
