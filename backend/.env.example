NODE_ENV=development
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────
# Option A : URL complète (Render, Neon…) — prioritaire si définie
# DATABASE_URL=postgres://user:password@host:5432/oz_db
# DB_SSL=true

# Option B : Postgres local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oz_db
DB_USER=postgres
DB_PASSWORD=your_password

# ── JWT ───────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64_random_bytes
JWT_2FA_SECRET=change_me_too_64_random_bytes
JWT_EXPIRES=7d
JWT_2FA_EXPIRES=5m

# ── Email (Gmail SMTP) ───────────────────────────────────────
# GMAIL_APP_PASSWORD = "mot de passe d'application" Google (16 caractères), PAS ton mot de passe Gmail :
#   https://myaccount.google.com/apppasswords  (la validation en 2 étapes doit être activée)
# Sans Gmail : comptes validés dès l'inscription, et "Forgot password" ouvre directement la page de reset (hors prod)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# MAIL_FROM="OZ Library <toi@gmail.com>"
# false = pas de vérification d'email à l'inscription, même avec Gmail configuré
EMAIL_VERIFICATION=true

# ── 2FA ───────────────────────────────────────────────────────
TOTP_APP_NAME=OZ Library

# ── URLs ──────────────────────────────────────────────────────
# Base publique utilisée dans les liens (vérif email, reset)
APP_URL=http://localhost:3000
# Seulement si un front est servi depuis une autre origine (sinon laisser vide)
# FRONTEND_URL=http://localhost:5500
